# =============================================================================
# SALA DE MISSÕES — Variáveis de Ambiente
# =============================================================================
# NUNCA commitar o arquivo .env real. Apenas este .env.example vai para o Git.
# Copie este arquivo: cp .env.example .env
# Preencha com seus valores reais no arquivo .env
# =============================================================================

# -----------------------------------------------------------------------------
# FIREBASE ADMIN SDK — BACKEND APENAS (NUNCA expor no frontend/browser)
# -----------------------------------------------------------------------------
# Gere em: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Documentação: https://firebase.google.com/docs/admin/setup

FIREBASE_PROJECT_ID=salam-33122
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# A FIREBASE_PRIVATE_KEY deve incluir as quebras de linha escapadas como \n
# Exemplo: "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

FIREBASE_STORAGE_BUCKET=salam-33122.firebasestorage.app

# -----------------------------------------------------------------------------
# SERVIDOR EXPRESS (Backend)
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Segredo para assinar tokens internos (gere com: openssl rand -hex 32)
INTERNAL_API_SECRET=

# -----------------------------------------------------------------------------
# FIREBASE WEB SDK — FRONTEND (configuração pública, protegida por Security Rules)
# Estes valores são PÚBLICOS mas devem ser protegidos por:
# 1. Firebase Security Rules (Firestore/Storage)
# 2. Restrições de API Key no Google Cloud Console
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyB0wBLe5vBCLy01dQGHlWldLMGoJhvcxMw
VITE_FIREBASE_AUTH_DOMAIN=salam-33122.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=salam-33122
VITE_FIREBASE_STORAGE_BUCKET=salam-33122.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=224816895471
VITE_FIREBASE_APP_ID=1:224816895471:web:61b61fe98f828c06e1121a
VITE_FIREBASE_MEASUREMENT_ID=G-EK0V5W8T71

# -----------------------------------------------------------------------------
# FRONTEND — Configuração da API
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001
# Fallback para dados mockados (apenas para desenvolvimento/demonstração)
# Em produção DEVE ser false
VITE_ENABLE_MOCK_FALLBACK=true

# -----------------------------------------------------------------------------
# GEMINI AI (para funcionalidades de IA)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL

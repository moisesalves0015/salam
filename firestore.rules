rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasValidDocData() {
      return request.resource.data.keys().size() > 0;
    }

    // Catálogos e Estruturas Escolares
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /classrooms/{classroomId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    // Estudantes e Progresso Pedagógico
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if hasValidDocData();
      allow delete: if true;
    }

    match /abilities/{abilityId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /studentAbilities/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    // Trilhas, Currículo Interativo e Missões
    match /trails/{trailId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /curriculumTracks/{trackId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /missions/{missionId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /studentMissions/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /missionAttempts/{attemptId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    // Intervenções e Diagnósticos
    match /interventions/{interventionId} {
      allow read: if true;
      allow create, update: if hasValidDocData();
      allow delete: if true;
    }

    match /diagnostics/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    // Gamificação: Cards, Conquistas, Loja e Banco de Moedas
    match /cards/{cardId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /studentCards/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /studentAchievements/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update: if hasValidDocData();
      allow delete: if true;
    }

    match /redemptions/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /coinTransactions/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /recognitionEvents/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /historyLogs/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /classMetrics/{docId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    // Migrações e Auditoria
    match /migrationRuns/{runId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    match /auditLogs/{logId} {
      allow read: if true;
      allow write: if hasValidDocData();
    }

    // Credenciais de PIN permanecem restritas ao Admin SDK
    match /studentCredentials/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

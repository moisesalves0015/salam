rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isMaster() { return isActiveUser() && profile().role == 'admin'; }
    function isTeacher() { return isActiveUser() && profile().role == 'professor'; }
    function isCoordinator() { return isActiveUser() && profile().role == 'coordenacao'; }
    function isStudent() { return isActiveUser() && profile().role == 'aluno'; }
    function ownSchool(schoolId) {
      return isActiveUser() && profile().schoolId is string && profile().schoolId == schoolId;
    }
    function teacherClassroom(classroomId) {
      return isTeacher() && profile().schoolId is string
        && profile().classroomIds is list && classroomId in profile().classroomIds;
    }
    function studentOwns(studentId) {
      return isStudent() && profile().studentId is string && profile().studentId == studentId;
    }
    function canReadStudent(studentId, student) {
      return isMaster() || studentOwns(studentId)
        || (isCoordinator() && ownSchool(student.schoolId))
        || (isTeacher() && ownSchool(student.schoolId) && teacherClassroom(student.classroomId));
    }
    function canReadStudentLinked(data) {
      return data.studentId is string
        && (isMaster() || studentOwns(data.studentId)
          || (exists(/databases/$(database)/documents/students/$(data.studentId))
            && canReadStudent(data.studentId, get(/databases/$(database)/documents/students/$(data.studentId)).data)));
    }

    match /users/{userId} {
      allow read: if isActiveUser() && (request.auth.uid == userId || isMaster()
        || (isCoordinator() && resource.data.schoolId == profile().schoolId));
      allow write: if isMaster();
    }
    match /schools/{schoolId} {
      allow read: if isMaster() || ownSchool(schoolId);
      allow write: if false;
    }
    match /classrooms/{classroomId} {
      allow read: if isMaster()
        || (isCoordinator() && ownSchool(resource.data.schoolId))
        || (isTeacher() && ownSchool(resource.data.schoolId) && teacherClassroom(classroomId));
      allow write: if false;
    }
    match /students/{studentId} {
      allow read: if isActiveUser() && canReadStudent(studentId, resource.data);
      allow write: if false;
    }
    match /studentAbilities/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /abilities/{id} { allow read: if isActiveUser(); allow write: if false; }
    match /studentMissions/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /missionAttempts/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /studentCards/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /studentAchievements/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /diagnostics/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /interventions/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /recognitionEvents/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /coinTransactions/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /redemptions/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }
    match /historyLogs/{id} { allow read: if isActiveUser() && canReadStudentLinked(resource.data); allow write: if false; }

    // Catálogos: leitura autenticada, sem escrita direta pelo cliente.
    match /trails/{id} { allow read: if isActiveUser(); allow write: if false; }
    match /missions/{id} { allow read: if isActiveUser(); allow write: if false; }
    match /cards/{id} { allow read: if isActiveUser(); allow write: if false; }
    match /achievements/{id} { allow read: if isActiveUser(); allow write: if false; }
    match /rewards/{id} { allow read: if isActiveUser(); allow write: if false; }

    // Explicitmente server-only; Admin SDK bypassa estas regras.
    match /studentCredentials/{id} { allow read, write: if false; }
    match /auditLogs/{id} { allow read, write: if false; }
    match /migrationRuns/{id} { allow read, write: if false; }
    match /migrations/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
